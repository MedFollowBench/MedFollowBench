{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedFollowBench session specification",
  "type": "object",
  "required": ["id", "task", "script_name", "patient_profile", "flow_requirements", "information_nodes", "detailed_flow_requirements", "target_information"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "task": {"const": "multi_turn_dialogue_simulation"},
    "script_name": {"type": "string"},
    "patient_profile": {"type": "string"},
    "flow_requirements": {"type": "string", "minLength": 1},
    "information_nodes": {"type": "string", "minLength": 1},
    "detailed_flow_requirements": {"type": "string", "minLength": 1},
    "target_information": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}, "description": "Simulator-only patient state; excluded from physician-model inputs."}
  },
  "additionalProperties": false
}
