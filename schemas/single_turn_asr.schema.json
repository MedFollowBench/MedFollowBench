{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedFollowBench spoken/ASR turn record",
  "description": "All single-turn fields, plus a current-response spoken/ASR condition label.",
  "type": "object",
  "required": ["id", "task", "script_name", "patient_profile", "flow_requirements", "conversation", "prompt_components", "asr_type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "task": {"const": "single_turn_next_response"},
    "script_name": {"type": "string"},
    "patient_profile": {"type": ["string", "null"]},
    "flow_requirements": {"type": "string", "minLength": 1},
    "conversation": {"type": "object", "required": ["raw_text", "messages", "message_count"], "properties": {"raw_text": {"type": "string", "minLength": 1}, "message_count": {"type": "integer", "minimum": 1}, "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"enum": ["assistant", "user"]}, "content": {"type": "string", "minLength": 1}}}}}},
    "prompt_components": {"type": "object", "required": ["history", "current_patient_reply"], "properties": {"history": {"type": "string"}, "current_patient_reply": {"type": "string", "minLength": 1}}},
    "organization": {"type": ["string", "null"]},
    "patient_name": {"type": ["string", "null"]},
    "patient_behavior_label": {"type": ["object", "null"]},
    "patient_behavior_label_raw": {"type": ["string", "null"]},
    "information_nodes": {"type": ["string", "null"]},
    "behavior_type": {"type": ["string", "null"]},
    "behavior_subtype": {"type": ["string", "null"]},
    "main_behavior_type": {"type": ["string", "null"]},
    "asr_type": {"enum": ["Text Normalization Errors", "Spoken ellipsis", "Homophone Error"]}
  },
  "additionalProperties": false
}
